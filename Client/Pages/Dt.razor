@page "/dt"
@using OnceDeOro.Data
@using OnceDeOro.Services
@implements IDisposable
@inject DtService Svc
@inject GameService Game
@inject Loc Loc

<PageTitle>Modo DT — Once de Oro</PageTitle>

<div class="section-title"><span class="dot"></span> 🧠 @Loc["Modo DT · Carrera de entrenador"]</div>

@if (Svc.Current is null || !Svc.Current.Started)
{
    @* ---------------- Crear entrenador ---------------- *@
    <div class="card card--pad">
        <p class="faint">@Loc["Creá tu entrenador y construí una carrera dirigiendo clubes: la directiva te pone objetivos, tu reputación crece con los títulos y los grandes te vienen a buscar."]</p>

        <div class="grid mt" style="grid-template-columns:1fr 1fr; gap:12px;">
            <label class="ed-lbl2">@Loc["Nombre"]
                <input class="search" maxlength="14" value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty" />
            </label>
            <label class="ed-lbl2">@Loc["Apellido"]
                <input class="search" maxlength="14" value="@_surname" @oninput="e => _surname = e.Value?.ToString() ?? string.Empty" />
            </label>
        </div>

        <div class="grid mt" style="grid-template-columns:1fr 1fr; gap:12px;">
            <label class="ed-lbl2">@Loc["Nacionalidad"]
                <select class="mkt-select" @bind="_nation">
                    @foreach (var n in CareerData.Nations)
                    {
                        <option value="@n.Name">@n.Name (@n.Code)</option>
                    }
                </select>
            </label>
            <label class="ed-lbl2">@Loc["Edad"]
                <select class="mkt-select" @bind="_age">
                    <option value="34">@Loc["Joven (34)"]</option>
                    <option value="45">@Loc["Adulto (45)"]</option>
                    <option value="58">@Loc["Veterano (58)"]</option>
                </select>
            </label>
        </div>

        <div class="ed-lbl mt">@Loc["Licencia de entrenador"]</div>
        <div class="seg wrap">
            <button class="@(_lic == DtLicense.Basica ? "on" : "")" @onclick="() => _lic = DtLicense.Basica">@Loc["Básica"]</button>
            <button class="@(_lic == DtLicense.Avanzada ? "on" : "")" @onclick="() => _lic = DtLicense.Avanzada">@Loc["Avanzada"]</button>
            <button class="@(_lic == DtLicense.Profesional ? "on" : "")" @onclick="() => _lic = DtLicense.Profesional">@Loc["Profesional"]</button>
        </div>
        <div class="faint mb" style="font-size:11.5px; margin-top:4px;">
            @(_lic == DtLicense.Basica ? Loc["Empezás en un club pequeño."]
              : _lic == DtLicense.Avanzada ? Loc["Empezás en un club mediano."]
              : Loc["Empezás en un club grande."])
        </div>

        <div class="ed-lbl mt">@Loc["Formación previa"]</div>
        <div class="seg wrap">
            @foreach (var b in Enum.GetValues<DtBackground>())
            {
                <button class="@(_bg == b ? "on" : "")" @onclick="() => _bg = b">@BgName(b)</button>
            }
        </div>

        <div class="ed-lbl mt">@Loc["Idiomas"]</div>
        <div class="seg wrap">
            @foreach (var lang in AllLangs)
            {
                <button class="@(_langs.Contains(lang) ? "on" : "")" @onclick="() => ToggleLang(lang)">@lang</button>
            }
        </div>
        <div class="faint mb" style="font-size:11.5px; margin-top:4px;">@Loc["Los idiomas ayudan a adaptarte a cada país (dan color a tu historia)."]</div>

        <button class="btn btn--gold btn--block mt" @onclick="Start">▶ @Loc["Empezar carrera de DT"]</button>
    </div>
}
else
{
    var dt = Svc.Current;

    @* ---------------- Ficha del DT ---------------- *@
    <div class="career-card">
        <div class="dt-face">
            @if (Game.State.Avatar.Creado)
            {
                <AvatarView A="Game.State.Avatar" Size="60" />
            }
            else
            {
                <span style="font-size:34px;">🧑‍💼</span>
            }
        </div>
        <div class="career-id">
            <div class="career-id__name">@dt.FullName · @dt.NationCode</div>
            <div class="career-id__club">
                @if (dt.Employed && dt.Club is not null)
                {
                    @($"{dt.Club.Emblem} {dt.Club.Name} · {DtData.LevelName(dt.Club.Level)} · {dt.Club.League}")
                }
                else { <span>@Loc["Sin equipo — libre"]</span> }
            </div>
            <div class="career-stats">
                <span>@Loc["Temporada"] <b>@dt.Year</b></span>
                <span><b>@DtEngine.RepName(dt.Rep)</b> · @Loc["reputación"]</span>
                <span>🏆 <b>@dt.Titles</b></span>
                <span><b>@dt.Wins</b>-@dt.Draws-@dt.Losses</span>
                @if (dt.Languages.Count > 0) { <span>🗣️ @string.Join(", ", dt.Languages)</span> }
            </div>
        </div>
    </div>

    @* Barras de reputación y confianza *@
    <div class="grid mt" style="grid-template-columns:1fr 1fr; gap:12px;">
        <div class="card card--pad">
            <div class="row" style="justify-content:space-between;"><span class="faint">@Loc["Reputación"]</span><b>@DtEngine.RepName(dt.Rep)</b></div>
            <div class="dt-bar mt"><i style="width:@dt.Rep%; background:linear-gradient(90deg,#cd7f32,#f5c542,#6fe0ff)"></i></div>
        </div>
        <div class="card card--pad">
            <div class="row" style="justify-content:space-between;"><span class="faint">@Loc["Confianza de la directiva"]</span><b>@DtEngine.ConfName(dt.Confidence)</b></div>
            <div class="dt-bar mt"><i style="width:@dt.Confidence%; background:@ConfColor(dt.Confidence)"></i></div>
        </div>
    </div>

    @* Ver el partido en la cancha 2D (como el modo principal) *@
    @if (_watching && _timeline is not null)
    {
        <div class="dt-watch">
            <div class="dt-watch__inner">
                <div class="dt-watch__ttl">🎥 @dt.Club!.Name <span class="faint">vs</span> @_awayName</div>
                <MatchField Timeline="_timeline"
                            HomeName="@dt.Club!.Name" HomeFlag="@dt.Club!.Emblem" HomeFormationName="@dt.Formation"
                            AwayName="@_awayName" AwayFlag="🔴"
                            HomeStarters="_home" AwayStarters="_away"
                            Round="🧠 Modo DT"
                            OnFinished="OnWatchFinished" />
            </div>
        </div>
    }

    @* Noticias del mundo (Pilar 4) *@
    @if (dt.News.Count > 0)
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">📰 @Loc["Noticias del mundo"]</div>
            @foreach (var n in dt.News)
            {
                <div class="dt-news"><span class="dt-news__i">@n.Icon</span> @n.Text</div>
            }
        </div>
    }

    @if (dt.Awards.Count > 0)
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">🏅 @Loc["Tus premios"]</div>
            <div class="row wrap" style="gap:6px;">
                @foreach (var a in dt.Awards)
                {
                    <span class="pill pill--gold">@a</span>
                }
            </div>
        </div>
    }

    @* Pestañas del Modo DT *@
    @if (dt.Employed && dt.Pending is null)
    {
        <div class="dt-tabs mt">
            <button class="@(_tab == "cal" ? "on" : "")" @onclick='() => _tab = "cal"'>📅 @Loc["Calendario"]</button>
            <button class="@(_tab == "squad" ? "on" : "")" @onclick='() => _tab = "squad"'>👥 @Loc["Plantilla"]</button>
            <button class="@(_tab == "tact" ? "on" : "")" @onclick='() => _tab = "tact"'>🧭 @Loc["Táctica"]</button>
            <button class="@(_tab == "table" ? "on" : "")" @onclick='() => _tab = "table"'>📊 @Loc["Tabla"]</button>
            <button class="@(_tab == "office" ? "on" : "")" @onclick='() => _tab = "office"'>🏢 @Loc["Oficina"]</button>
        </div>
    }

    @* --- Táctica --- *@
    @if (dt.Employed && dt.Pending is null && _tab == "tact")
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">🧭 @Loc["Mentalidad"]</div>
            <div class="seg wrap">
                @foreach (var t in new[] { ("ultradef", "Ultra def."), ("def", "Defensiva"), ("equilibrada", "Equilibrada"), ("of", "Ofensiva"), ("ultraof", "Ultra of.") })
                { <button class="@(dt.Mentality == t.Item1 ? "on" : "")" @onclick="() => Svc.SetTactics(t.Item1, dt.Tempo, dt.Press, dt.Build, dt.Line)">@t.Item2</button> }
            </div>
            <div class="ed-lbl mt">⏱️ @Loc["Ritmo"]</div>
            <div class="seg wrap">
                @foreach (var t in new[] { ("lento", "Lento"), ("normal", "Normal"), ("rapido", "Rápido") })
                { <button class="@(dt.Tempo == t.Item1 ? "on" : "")" @onclick="() => Svc.SetTactics(dt.Mentality, t.Item1, dt.Press, dt.Build, dt.Line)">@t.Item2</button> }
            </div>
            <div class="ed-lbl mt">🕸️ @Loc["Presión"]</div>
            <div class="seg wrap">
                @foreach (var t in new[] { ("baja", "Bloque bajo"), ("media", "Media"), ("alta", "Alta") })
                { <button class="@(dt.Press == t.Item1 ? "on" : "")" @onclick="() => Svc.SetTactics(dt.Mentality, dt.Tempo, t.Item1, dt.Build, dt.Line)">@t.Item2</button> }
            </div>
            <div class="ed-lbl mt">🎯 @Loc["Construcción"]</div>
            <div class="seg wrap">
                @foreach (var t in new[] { ("posesion", "Posesión"), ("directo", "Directo"), ("contra", "Contraataque") })
                { <button class="@(dt.Build == t.Item1 ? "on" : "")" @onclick="() => Svc.SetTactics(dt.Mentality, dt.Tempo, dt.Press, t.Item1, dt.Line)">@t.Item2</button> }
            </div>
            <div class="ed-lbl mt">🛡️ @Loc["Línea defensiva"]</div>
            <div class="seg wrap">
                @foreach (var t in new[] { ("baja", "Baja"), ("media", "Media"), ("alta", "Alta") })
                { <button class="@(dt.Line == t.Item1 ? "on" : "")" @onclick="() => Svc.SetTactics(dt.Mentality, dt.Tempo, dt.Press, dt.Build, t.Item1)">@t.Item2</button> }
            </div>
            <div class="faint mt" style="font-size:11.5px;">@Loc["Más ritmo/presión y línea alta = más goles de los dos lados y más cansancio. La mentalidad ofensiva ataca más pero deja espacios atrás."]</div>
        </div>
    }

    @* --- Calendario --- *@
    @if (dt.Employed && dt.Pending is null && _tab == "cal")
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">🎯 @Loc["Objetivos de la directiva"] · @Loc["Temporada"] @dt.Year</div>
            @foreach (var o in dt.Objectives) { <div class="dt-obj">▪ @o.Text</div> }
            @if (dt.Warned) { <div class="clash mt"><div class="clash__txt">⚠️ @Loc["La directiva avisó: tu puesto está en riesgo."]</div></div> }
        </div>

        @if (dt.SeasonInPlay && dt.Week < dt.Calendar.Count)
        {
            var w = dt.Calendar[dt.Week];
            <div class="card card--pad center mt">
                <div class="faint">📅 @w.Month · @Loc["Semana"] @(dt.Week + 1) / @dt.Calendar.Count</div>

                @if (dt.PressPending is { } press)
                {
                    <div class="dt-result mt" style="font-size:17px;">@press.Title</div>
                    <div class="faint mb">@press.Text</div>
                    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px;">
                        @foreach (var o in press.Options)
                        {
                            <button class="career-opt" @onclick="() => AnswerPress(o)">
                                <div class="career-opt__label">@o.Label</div>
                                <div class="career-opt__sub">@o.Sub</div>
                            </button>
                        }
                    </div>
                }
                else if (w.Type == "match" && dt.Round < dt.Fixture.Count)
                {
                    var m = dt.Fixture[dt.Round];
                    <div class="dt-result" style="font-size:19px; margin-top:2px;">⚽ @(m.Home ? "🏠" : "✈") @dt.Club!.Name <span class="faint">vs</span> @m.Opp</div>
                    <div class="faint" style="font-size:12px;">@Loc["Rival"] @m.OppStrength · @Loc["tu XI"] @DtEngine.XiStrength(dt) · @dt.Formation</div>
                    <div class="row" style="gap:8px; justify-content:center; margin-top:10px;">
                        <button class="btn btn--gold btn--big" @onclick="WatchMatch">🎥 @Loc["Ver el partido"]</button>
                        <button class="btn btn--ghost" @onclick="AdvanceWeek">⚡ @Loc["Jugar rápido"]</button>
                    </div>
                }
                else
                {
                    <div class="dt-result mt" style="font-size:17px;">@(w.Type == "train" ? "🏋️ " + Loc["Semana de entrenamiento"] : "🛌 " + Loc["Semana de descanso"])</div>
                    <button class="btn btn--gold btn--big mt" @onclick="AdvanceWeek">▶ @Loc["Avanzar semana"]</button>
                }

                @if (dt.PressPending is null)
                {
                    <div class="row" style="gap:8px; justify-content:center; margin-top:10px;">
                        <button class="btn btn--ghost" @onclick="ToNextMatch">⏩ @Loc["Hasta el próximo partido"]</button>
                        <button class="btn btn--ghost" @onclick="SimRest">⏩⏩ @Loc["Simular temporada"]</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(dt.WeekMsg))
                {
                    <div class="pill mt">@dt.WeekMsg</div>
                }
            </div>

            <div class="card card--pad mt">
                <div class="ed-lbl">🏋️ @Loc["Plan de entrenamiento de la semana"]</div>
                <div class="seg wrap">
                    @foreach (var pl in Plans)
                    {
                        <button class="@(dt.TrainPlan == pl.k ? "on" : "")" @onclick="() => SetTrain(pl.k, dt.TrainIntensity)">@pl.lbl</button>
                    }
                </div>
                <div class="ed-lbl mt">@Loc["Intensidad"]</div>
                <div class="seg wrap">
                    @foreach (var it in new[] { "baja", "normal", "alta" })
                    {
                        <button class="@(dt.TrainIntensity == it ? "on" : "")" @onclick="() => SetTrain(dt.TrainPlan, it)">@it</button>
                    }
                </div>
            </div>
        }

        var played = dt.Fixture.Where(x => x.Played).OrderByDescending(x => x.Round).Take(10).ToList();
        @if (played.Count > 0)
        {
            <div class="card card--pad mt">
                <div class="ed-lbl">📋 @Loc["Resultados"]</div>
                @foreach (var x in played)
                {
                    var win = x.MyGoals > x.OppGoals; var draw = x.MyGoals == x.OppGoals;
                    <div class="dt-fixrow">
                        <span class="dt-fixres @(win ? "w" : draw ? "d" : "l")">@x.MyGoals–@x.OppGoals</span>
                        <span class="faint">@(x.Home ? Loc["vs"] : "@")</span> <span>@x.Opp</span>
                    </div>
                }
            </div>
        }

        <div class="center mt">
            <button class="btn btn--ghost" @onclick="() => _showCal = !_showCal">📅 @(_showCal ? Loc["Ocultar calendario"] : Loc["Ver calendario completo"])</button>
        </div>
        @if (_showCal)
        {
            <div class="card card--pad mt">
                <div class="ed-lbl">📅 @Loc["Calendario de la temporada"]</div>
                @foreach (var r in BuildCal(dt))
                {
                    <div class="dt-cal-row @(r.Now ? "is-now" : "")">
                        <span>@r.Icon</span> <span class="faint" style="min-width:74px;">@r.Month</span> <span>@r.Label</span>
                    </div>
                }
            </div>
        }
    }

    @* --- Plantilla --- *@
    @if (dt.Employed && dt.Pending is null && _tab == "squad")
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">🟩 @Loc["Tu once"] · @dt.Formation</div>
            <div class="dt-pitch">
                @foreach (var line in new[] { Position.FWD, Position.MID, Position.DEF, Position.GK })
                {
                    <div class="dt-pitch__line">
                        @foreach (var p in DtEngine.BestXI(dt).Where(x => x.Pos == line))
                        {
                            <div class="dt-badge">
                                <div class="dt-badge__m">@p.Media</div>
                                <div class="dt-badge__n">@Short(p.Name)</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card card--pad mt">
            <div class="row" style="justify-content:space-between; align-items:center;">
                <div class="ed-lbl" style="margin:0;">👥 @Loc["Plantilla"] (@dt.Squad.Count) · @Loc["once"] @dt.Lineup.Count/11</div>
                <div class="row" style="gap:6px;">
                    <select class="mkt-select" style="width:auto;" @bind="Formation">
                        @foreach (var f in DtEngine.Formations) { <option value="@f">@f</option> }
                    </select>
                    <button class="btn btn--ghost" @onclick="AutoXI">@Loc["XI auto"]</button>
                </div>
            </div>
            <div class="faint mb" style="font-size:11.5px;">@Loc["Tocá ⭐ para el once (11). Tocá el nombre para comparar (2). 🖊️ renovar · 💰 vender."]</div>
            @if (!string.IsNullOrEmpty(Svc.MarketMsg))
            {
                <div class="pill @(Svc.MarketMsg.StartsWith("No ") ? "pill--red" : "pill--green") mb">@Svc.MarketMsg</div>
            }
            <div class="grid" style="gap:6px;">
                @foreach (var p in dt.Squad.OrderByDescending(p => dt.Lineup.Contains(p.Id)).ThenByDescending(p => p.Media))
                {
                    var starter = dt.Lineup.Contains(p.Id);
                    <div class="dt-player @(starter ? "is-xi" : "") @(p.InjuryWeeks > 0 ? "is-injured" : "")">
                        <button class="dt-star @(starter ? "on" : "")" @onclick="() => Svc.ToggleStarter(p.Id)">⭐</button>
                        <div class="dt-player__id" @onclick="() => PickCompare(p)">
                            <div><b>@PosName(p.Pos)</b> @p.Name <span class="faint">· @p.NationCode · @p.Age</span></div>
                            <div class="faint" style="font-size:11px;">M @p.Media · Pot @p.Potential · @p.Apps PJ · @p.Goals G · @p.Assists A @(p.InjuryWeeks > 0 ? "· 🤕 " + DtEngine.InjuryLevel(p.InjuryWeeks) : "")</div>
                        </div>
                        <div class="dt-player__meta faint">💪@p.Morale 🥵@p.Fatigue</div>
                        <div class="dt-player__act">
                            <button class="dt-tiny" title="@Loc["Renovar"]" @onclick="() => Svc.Renew(p.Id)">🖊️</button>
                            <button class="dt-tiny" title="@Loc["Vender"]" @onclick="() => Svc.Sell(p.Id)">💰</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_cmp.Count > 0)
        {
            <div class="card card--pad mt">
                <div class="row" style="justify-content:space-between;">
                    <div class="ed-lbl" style="margin:0;">⚖️ @Loc["Comparar jugadores"]</div>
                    <button class="btn btn--ghost" style="padding:4px 10px;" @onclick="() => _cmp.Clear()">@Loc["Limpiar"]</button>
                </div>
                <div class="grid" style="grid-template-columns:repeat(@_cmp.Count,1fr); gap:10px; margin-top:6px;">
                    @foreach (var p in _cmp)
                    {
                        <div class="dt-cmp">
                            <div class="dt-cmp__n">@PosName(p.Pos) @p.Name</div>
                            <div class="dt-cmp__r">@p.Media</div>
                            <div class="faint" style="font-size:12px; line-height:1.5;">
                                @Loc["Pot"] @p.Potential · @p.Age @Loc["años"] · @p.NationCode<br />
                                @Loc["Valor"] $@p.ValueM M · @Loc["Sueldo"] $@p.SalaryM M<br />
                                @p.Apps PJ · @p.Goals G · @p.Assists A · 💪@p.Morale · 🥵@p.Fatigue
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* --- Tabla --- *@
    @if (dt.Employed && dt.Pending is null && _tab == "table")
    {
        <div class="card table-wrap mt">
            <table class="ltable">
                <thead><tr><th>#</th><th class="ltable__team">@Loc["Equipo"]</th><th>PJ</th><th>G</th><th>E</th><th>P</th><th>GF</th><th>GC</th><th>DIF</th><th>PTS</th></tr></thead>
                <tbody>
                    @{ int rp = 0; }
                    @foreach (var r in DtEngine.Standings(dt))
                    {
                        rp++;
                        <tr class="@(r.IsMe ? "me" : "")">
                            <td>@rp</td><td class="ltable__team">@r.Name</td>
                            <td>@r.Played</td><td>@r.Won</td><td>@r.Drawn</td><td>@r.Lost</td>
                            <td>@r.GF</td><td>@r.GA</td><td>@(r.Diff > 0 ? "+" : "")@r.Diff</td><td class="ltable__pts">@r.Pts</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        var scorers = dt.Squad.Where(p => p.Goals > 0).OrderByDescending(p => p.Goals).ThenByDescending(p => p.Assists).Take(6).ToList();
        @if (scorers.Count > 0)
        {
            <div class="card card--pad mt">
                <div class="ed-lbl">⚽ @Loc["Goleadores del equipo"]</div>
                @foreach (var p in scorers)
                {
                    <div class="dt-fixrow"><span class="dt-fixres w">@p.Goals</span> <span>@p.Name</span> <span class="faint">· @p.Assists @Loc["asist."]</span></div>
                }
            </div>
        }
    }

    @* Oficina / finanzas (dentro de la pestaña Oficina) *@
    @if (dt.Employed && dt.Pending is null && _tab == "office")
    {
        var bal = dt.LastIncomeM - dt.LastExpenseM;
        <div class="card card--pad mt">
            <div class="ed-lbl">🏢 @Loc["Oficina · Finanzas"]</div>
            <div class="faint mb" style="font-size:11.5px; margin-top:2px;">@Loc["Acá manejás la plata del club: la caja (ahorro), el presupuesto de fichajes (lo que la directiva te deja gastar), mejorás las instalaciones y pedís préstamos."]</div>
            <div class="career-stats" style="margin-top:2px;">
                <span>@Loc["Caja"] <b>$@dt.CajaM M</b></span>
                <span>@Loc["Fichajes"] <b>$@dt.TransferBudgetM M</b></span>
                <span>@Loc["Fuerza del club"] <b>@dt.Club!.Strength</b></span>
                @if (dt.LastIncomeM > 0 || dt.LastExpenseM > 0)
                {
                    <span>@Loc["Balance"] <b style="color:@(bal >= 0 ? "#37d67a" : "#e23b3b")">@(bal >= 0 ? "+" : "")@bal M</b></span>
                }
                @if (dt.LoanRemainingM > 0) { <span>@Loc["Deuda"] <b style="color:#ff9a3d">$@dt.LoanRemainingM M</b></span> }
            </div>

            <div class="ed-lbl mt">💪 @Loc["Reforzar el plantel"]</div>
            <div class="row wrap" style="gap:8px; align-items:center;">
                <input type="number" class="search" style="width:100px;" min="0" max="@dt.TransferBudgetM"
                       value="@_reinf" @oninput="e => int.TryParse(e.Value?.ToString(), out _reinf)" />
                <button class="btn btn--gold" disabled="@(dt.TransferBudgetM <= 0)" @onclick="Reinforce">➕ @Loc["Fichar (sube la fuerza)"]</button>
                <span class="faint" style="font-size:11.5px;">@Loc["del presupuesto de fichajes"]</span>
            </div>

            <div class="ed-lbl mt">🏗️ @Loc["Instalaciones (mejoras permanentes)"]</div>
            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:8px;">
                @foreach (var f in new[] { ("train", "🏋️ " + Loc["Centro"], dt.TrainCenter), ("youth", "🎓 " + Loc["Cantera"], dt.Youth), ("medical", "🏥 " + Loc["Médico"], dt.Medical), ("scouting", "🔎 " + Loc["Scouting"], dt.Scouting) })
                {
                    var cost = DtEngine.FacilityCost(f.Item3);
                    <div class="dt-fac">
                        <div class="dt-fac__n">@f.Item2 · @Loc["Nv"] @f.Item3</div>
                        @if (f.Item3 >= 5)
                        {
                            <span class="pill pill--gold">@Loc["Máximo"]</span>
                        }
                        else
                        {
                            <button class="btn btn--ghost" disabled="@(dt.CajaM < cost)" @onclick="() => Upgrade(f.Item1)">@Loc["Mejorar"] $@cost M</button>
                        }
                    </div>
                }
            </div>

            <div class="ed-lbl mt">🏦 @Loc["Préstamo"]</div>
            <div class="row wrap" style="gap:8px; align-items:center;">
                <input type="number" class="search" style="width:100px;" min="0" max="300"
                       value="@_loan" @oninput="e => int.TryParse(e.Value?.ToString(), out _loan)" />
                <button class="btn btn--ghost" @onclick="Loan">🏦 @Loc["Pedir préstamo"]</button>
                <span class="faint" style="font-size:11.5px;">@Loc["entra a la caja; se paga en 4 temporadas (+15%)"]</span>
            </div>
        </div>
    }

    @* Mercado y scouting (dentro de la pestaña Oficina) *@
    @if (dt.Employed && dt.Pending is null && _tab == "office")
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">🔎 @Loc["Mercado y scouting"]</div>
            <div class="row wrap" style="gap:8px; align-items:center;">
                <select class="mkt-select" style="width:auto;" @bind="_scoutPos">
                    <option value="-1">@Loc["Todas las posiciones"]</option>
                    <option value="0">POR</option>
                    <option value="1">DFC</option>
                    <option value="2">MC</option>
                    <option value="3">DC</option>
                </select>
                <input type="number" class="search" style="width:120px;" placeholder="@Loc["Media mín."]"
                       value="@_scoutMin" @oninput="e => int.TryParse(e.Value?.ToString(), out _scoutMin)" />
                <button class="btn btn--gold" @onclick="DoScout">🔎 @Loc["Buscar jugadores"]</button>
            </div>
            @if (!string.IsNullOrEmpty(Svc.MarketMsg))
            {
                <div class="pill @(Svc.MarketMsg.StartsWith("✔") ? "pill--green" : "pill--red")" style="margin-top:8px;">@Svc.MarketMsg</div>
            }
            @if (dt.ScoutPool.Count > 0)
            {
                <div class="grid mt" style="gap:8px;">
                    @foreach (var p in dt.ScoutPool)
                    {
                        <div class="dt-prospect">
                            <div>
                                <b>@p.Name</b> · @p.NationCode · @PosName(p.Pos) · @p.Age @Loc["años"]
                                <div class="faint" style="font-size:11.5px;">@Loc["Media"] <b>@p.Media</b> · @Loc["Pot."] @p.Potential · @(p.Free ? Loc["Agente libre"] : p.Club)</div>
                            </div>
                            <div class="dt-prospect__buy">
                                <span class="dt-prospect__val">@(p.Free ? Loc["Libre"] : "$" + p.ValueM + "M")</span>
                                @if (!p.Free)
                                {
                                    <input type="number" class="search" style="width:74px;" value="@Offer(p)" @onchange="e => SetOffer(p.Id, e.Value?.ToString())" />
                                }
                                <button class="btn btn--gold" @onclick="() => DoSign(p)">💰 @Loc["Fichar"]</button>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (dt.Signings.Count > 0)
            {
                <div class="ed-lbl mt">🖊️ @Loc["Fichajes"]</div>
                <div class="row wrap" style="gap:6px;">
                    @foreach (var s in dt.Signings)
                    {
                        <span class="pill">@s</span>
                    }
                </div>
            }
        </div>
    }

    @* Mercado de jugadores REALES (leyendas del juego, como el modo principal) *@
    @if (dt.Employed && dt.Pending is null && _tab == "office")
    {
        <div class="card card--pad mt">
            <div class="ed-lbl">⭐ @Loc["Fichar leyendas (mercado real)"]</div>
            <div class="faint mb" style="font-size:11.5px;">@Loc["Jugadores reales del juego, como el modo principal. Se pagan del presupuesto de fichajes."]</div>
            <div class="seg wrap">
                <button class="@(_realEra == "current" ? "on" : "")" @onclick='() => _realEra = "current"'>@Loc["Actuales"]</button>
                <button class="@(_realEra == "legend" ? "on" : "")" @onclick='() => _realEra = "legend"'>@Loc["Leyendas"]</button>
                <button class="@(_realEra == "all" ? "on" : "")" @onclick='() => _realEra = "all"'>@Loc["Todos"]</button>
            </div>
            <div class="row wrap" style="gap:8px; align-items:center; margin-top:8px;">
                <select class="mkt-select" style="width:auto;" @bind="_realPos">
                    <option value="-1">@Loc["Todas las posiciones"]</option>
                    <option value="0">POR</option>
                    <option value="1">DFC</option>
                    <option value="2">MC</option>
                    <option value="3">DC</option>
                </select>
                <input class="search" style="width:160px;" placeholder="@Loc["Buscar nombre…"]"
                       value="@_realSearch" @oninput="e => _realSearch = e.Value?.ToString() ?? string.Empty" />
            </div>
            @if (!string.IsNullOrEmpty(Svc.MarketMsg))
            {
                <div class="pill @(Svc.MarketMsg.StartsWith("✔") ? "pill--green" : "pill--red") mb" style="margin-top:8px;">@Svc.MarketMsg</div>
            }
            <div class="grid mt" style="gap:8px;">
                @foreach (var p in DtEngine.RealMarket(dt, _realPos < 0 ? null : (Position)_realPos, _realSearch, _realEra))
                {
                    var price = DtEngine.RealPrice(dt, p);
                    <div class="dt-prospect">
                        <div>
                            <b>@p.Flag @p.Name</b> @(p.IsLegend ? "⭐" : "")
                            <div class="faint" style="font-size:11.5px;">@PosName(p.Pos) · @Loc["media"] @DtEngine.EffRating(dt, p) · @p.Nation</div>
                        </div>
                        <div class="dt-prospect__buy">
                            <span class="dt-prospect__val">$@price M</span>
                            <button class="btn btn--gold" disabled="@(dt.TransferBudgetM < price)" @onclick="() => Svc.SignReal(p.Id)">💰 @Loc["Fichar"]</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Decisión de fin de temporada / sin equipo *@
    @if (dt.Pending is { } dec)
    {
        <div class="card card--pad mt career-decision">
            <div class="career-decision__ttl">@dec.Title</div>
            <div class="faint mb">@dec.Text</div>
            @if (dt.Timeline.Count > 0)
            {
                var last = dt.Timeline[0];
                <div class="dt-result mb">@last.Club · @last.Pos@Loc["º"] · @last.Won-@last.Drawn-@last.Lost · @(last.Titles.Count > 0 ? string.Join(" ", last.Titles) : "")</div>
            }
            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:10px;">
                @foreach (var o in dec.Options)
                {
                    <button class="career-opt" @onclick="() => Choose(o)">
                        <div class="career-opt__label">@o.Label</div>
                        <div class="career-opt__sub">@o.Sub</div>
                    </button>
                }
            </div>
        </div>
    }

    @* Historial de temporadas *@
    @if (dt.Timeline.Count > 0)
    {
        <div class="section-title" style="margin-top:22px;"><span class="dot"></span> @Loc["Trayectoria del DT"]</div>
        <div class="card table-wrap">
            <table class="ltable">
                <thead>
                    <tr><th>@Loc["Temp."]</th><th class="ltable__team">@Loc["Club"]</th><th>@Loc["Pos"]</th><th>G-E-P</th><th class="ltable__team">@Loc["Logro"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in dt.Timeline)
                    {
                        <tr>
                            <td>@s.Year</td>
                            <td class="ltable__team">@s.Club</td>
                            <td class="ltable__pts">@s.Pos@Loc["º"]</td>
                            <td>@s.Won-@s.Drawn-@s.Lost</td>
                            <td class="ltable__team" style="font-size:12px; color:var(--gold-2);">@s.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card card--pad center mt">
            <b style="font-family:var(--font-display); font-size:22px; color:var(--gold-2);">@DtEngine.Legacy(dt)</b>
            <div class="faint" style="font-size:12px;">
                @dt.SeasonsManaged @Loc["temporadas"] · @dt.ClubsManaged.Count @Loc["clubes"] · @dt.TimesFired @Loc["despidos"] · @dt.Awards.Count @Loc["premios"]
            </div>
        </div>

        @if (dt.WorldLog.Count > 0)
        {
            <div class="section-title" style="margin-top:22px;"><span class="dot"></span> 🌍 @Loc["Historia del mundo"]</div>
            <div class="card card--pad">
                @foreach (var w in dt.WorldLog)
                {
                    <div class="dt-news" style="font-size:12.5px;">@w</div>
                }
            </div>
        }
    }

    <div class="center mt">
        @if (_confirmReset)
        {
            <span class="faint">@Loc["¿Seguro? Se borra esta carrera de DT."]</span>
            <button class="btn btn--gold" style="margin-left:8px;" @onclick="Reset">@Loc["Sí, nueva"]</button>
            <button class="btn btn--ghost" style="margin-left:6px;" @onclick="() => _confirmReset = false">@Loc["Cancelar"]</button>
        }
        else
        {
            <button class="btn btn--ghost" @onclick="() => _confirmReset = true">↺ @Loc["Nueva carrera de DT"]</button>
        }
    </div>
}

@code {
    private string _name = "";
    private string _surname = "";
    private string _nation = "Argentina";
    private int _age = 45;
    private DtLicense _lic = DtLicense.Basica;
    private DtBackground _bg = DtBackground.Exjugador;
    private bool _confirmReset;
    private int _reinf;
    private int _loan;
    private int _scoutPos = -1;
    private int _scoutMin;
    private readonly Dictionary<string, int> _offers = new();
    private int _realPos = -1;
    private string _realSearch = "";
    private string _realEra = "current";
    private bool _showCal;

    private record CalRow(string Icon, string Label, string Month, bool Now);
    private List<CalRow> BuildCal(DtManager dt)
    {
        var rows = new List<CalRow>(); int mc = 0;
        foreach (var w in dt.Calendar)
        {
            string icon, label;
            if (w.Type == "match")
            {
                var fx = mc < dt.Fixture.Count ? dt.Fixture[mc] : null; mc++;
                icon = "⚽";
                label = fx is null ? "" : fx.Played
                    ? (fx.Home ? $"{dt.Club!.Name} {fx.MyGoals}-{fx.OppGoals} {fx.Opp}" : $"{fx.Opp} {fx.OppGoals}-{fx.MyGoals} {dt.Club!.Name}")
                    : $"vs {fx.Opp}";
            }
            else if (w.Type == "train") { icon = "🏋️"; label = Loc["Entrenamiento"]; }
            else if (w.Type == "press") { icon = "🎙️"; label = Loc["Prensa"]; }
            else { icon = "🛌"; label = Loc["Descanso"]; }
            rows.Add(new CalRow(icon, label, w.Month, w.Index == dt.Week));
        }
        return rows;
    }
    private string _tab = "cal";
    private readonly List<DtPlayer> _cmp = new();
    private bool _watching;
    private OnceDeOro.Models.MatchTimeline? _timeline;
    private List<Player> _home = new();
    private List<Player> _away = new();
    private string _awayName = "";
    private static readonly string[] AllLangs = { "Español", "Inglés", "Italiano", "Francés", "Alemán", "Portugués" };
    private readonly HashSet<string> _langs = new() { "Español" };
    private void ToggleLang(string l) { if (!_langs.Remove(l)) _langs.Add(l); }

    private string Formation
    {
        get => Svc.Current?.Formation ?? "4-3-3";
        set => Svc.SetFormation(value);
    }

    protected override async Task OnInitializedAsync()
    {
        Svc.Changed += OnChanged;
        Game.Changed += OnChanged;
        Loc.Changed += OnChanged;
        await Svc.LoadAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static readonly (string k, string lbl)[] Plans =
    {
        ("tactica", "Táctica"), ("ataque", "Ataque"), ("defensa", "Defensa"),
        ("fisico", "Físico"), ("balon", "Balón parado"), ("juvenil", "Juveniles"), ("recuperacion", "Recuperación"),
    };

    private void Start() => Svc.Start(_name, _surname, _nation, _age, _lic, _bg, _langs.ToList());
    private void AdvanceWeek() => Svc.AdvanceWeek();
    private void ToNextMatch() => Svc.AdvanceToNextMatch();

    private void WatchMatch()
    {
        var d = DtEngine.MatchViewData(Svc.Current!);
        if (d is null) return;
        _home = d.Value.home; _away = d.Value.away; _awayName = d.Value.oppName;
        _timeline = MatchSimulator.Simulate(
            Svc.Current!.Club!.Name, Svc.Current!.Club!.Emblem, TeamPower.Flat(d.Value.homeStr), _home,
            _awayName, "🔴", TeamPower.Flat(d.Value.awayStr), _away,
            knockout: false, seed: new Random().Next());
        _watching = true;
    }

    private void OnWatchFinished()
    {
        if (_timeline is not null) Svc.FinishWatchedMatch(_timeline.Result.HomeGoals, _timeline.Result.AwayGoals);
        _watching = false; _timeline = null;
    }
    private void SimRest() => Svc.SimRest();
    private void AnswerPress(DtOption o) => Svc.AnswerPress(o);
    private void SetTrain(string plan, string intensity) => Svc.SetTraining(plan, intensity);
    private void AutoXI() => Svc.AutoLineup();
    private void PickCompare(DtPlayer p)
    {
        if (_cmp.Any(x => x.Id == p.Id)) _cmp.RemoveAll(x => x.Id == p.Id);
        else { if (_cmp.Count >= 2) _cmp.RemoveAt(0); _cmp.Add(p); }
    }
    private void Choose(DtOption o) { Svc.Choose(o); _tab = "cal"; }
    private void Reinforce() { Svc.Reinforce(_reinf); _reinf = 0; }
    private void Upgrade(string which) => Svc.Upgrade(which);
    private void Loan() { Svc.Loan(_loan); _loan = 0; }

    private void DoScout() => Svc.Scout(_scoutPos < 0 ? null : (Position)_scoutPos, _scoutMin);
    private void DoSign(DtProspect p) => Svc.Sign(p.Id, Offer(p));
    private int Offer(DtProspect p) => _offers.TryGetValue(p.Id, out var v) ? v : p.ValueM;
    private void SetOffer(string id, string? raw) { if (int.TryParse(raw, out var v)) _offers[id] = Math.Max(0, v); }
    private static string PosName(Position p) => p switch { Position.GK => "POR", Position.DEF => "DFC", Position.MID => "MC", _ => "DC" };
    private static string Short(string n) { var parts = n.Split(' '); return parts.Length == 1 ? n : parts[^1]; }
    private async Task Reset() { _confirmReset = false; await Svc.ResetAsync(); }

    private string BgName(DtBackground b) => b switch
    {
        DtBackground.Exjugador => Loc["Exjugador"],
        DtBackground.Cantera => Loc["De cantera"],
        DtBackground.Analista => Loc["Analista táctico"],
        DtBackground.Preparador => Loc["Preparador físico"],
        _ => Loc["Estudiante"],
    };

    private static string ConfColor(int c) =>
        c >= 60 ? "#37d67a" : c >= 40 ? "#f5c542" : c >= 20 ? "#ff9a3d" : "#e23b3b";

    public void Dispose()
    {
        Svc.Changed -= OnChanged;
        Game.Changed -= OnChanged;
        Loc.Changed -= OnChanged;
    }
}
